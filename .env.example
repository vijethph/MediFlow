# Healthcare Patient Management System - Environment Configuration
# Copy this file to .env and update the values

# ============================================
# Security - JWT Configuration
# ============================================
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# ============================================
# Database Credentials
# ============================================
# Patient Service Database
PATIENT_DB_PASSWORD=patient_secure_password

# Appointment Service Database
APPOINTMENT_DB_PASSWORD=appointment_secure_password

# Prescription Service Database (MongoDB)
MONGO_USERNAME=admin
MONGO_PASSWORD=mongo_secure_password

# Billing Service Database
BILLING_DB_PASSWORD=billing_secure_password

# ============================================
# API Gateway - Kong
# ============================================
KONG_DB_PASSWORD=kong_secure_password

# ============================================
# Message Broker - RabbitMQ
# ============================================
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=rabbitmq_secure_password

# ============================================
# Cache - Redis
# ============================================
REDIS_PASSWORD=redis_secure_password

# ============================================
# Monitoring - Grafana
# ============================================
GRAFANA_PASSWORD=grafana_secure_password

# ============================================
# Application Configuration
# ============================================
# Environment (development, staging, production)
ENVIRONMENT=development

# Log Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# ============================================
# Service URLs (for inter-service communication)
# ============================================
PATIENT_SERVICE_URL=http://patient-service:8000
APPOINTMENT_SERVICE_URL=http://appointment-service:8000
PRESCRIPTION_SERVICE_URL=http://prescription-service:8000
BILLING_SERVICE_URL=http://billing-service:8000

# ============================================
# External Services (Optional)
# ============================================
# Email Service Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USERNAME=your-email@example.com
EMAIL_PASSWORD=your-email-password

# SMS Service Configuration (e.g., Twilio)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# ============================================
# Feature Flags
# ============================================
ENABLE_AUDIT_LOGGING=true
ENABLE_RATE_LIMITING=true
ENABLE_CIRCUIT_BREAKER=true
