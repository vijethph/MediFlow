architecture-beta
    group api_layer(cloud)[API Layer]
    group network_layer(internet)[API Gateway]
    group microservices(server)[Microservices Layer]
    group data_layer(database)[Data Layer]
    group messaging_caching(server)[Messaging and Caching]
    group monitoring(server)[Monitoring]

    service client(internet)[Client Applications] in api_layer
    service gateway(server)[Kong Gateway] in network_layer

    service patient_svc(server)[Patient Service] in microservices
    service appointment_svc(server)[Appointment Service] in microservices
    service prescription_svc(server)[Prescription Service] in microservices
    service billing_svc(server)[Billing Service] in microservices

    service patient_db(database)[Patient DB] in data_layer
    service appointment_db(database)[Appointment DB] in data_layer
    service prescription_db(database)[Prescription DB] in data_layer
    service billing_db(database)[Billing DB] in data_layer

    service rabbitmq(server)[RabbitMQ] in messaging_caching
    service redis(disk)[Redis Cache] in messaging_caching

    service prometheus(server)[Prometheus] in monitoring
    service grafana(server)[Grafana] in monitoring

    client:R -- L:gateway
    gateway:B -- T:patient_svc
    gateway:B -- T:appointment_svc
    gateway:B -- T:prescription_svc
    gateway:B -- T:billing_svc

    patient_svc:B -- T:patient_db
    appointment_svc:B -- T:appointment_db
    prescription_svc:B -- T:prescription_db
    billing_svc:B -- T:billing_db

    appointment_svc:R -- L:patient_svc
    billing_svc:R -- L:appointment_svc
    prescription_svc:R -- L:patient_svc

    patient_svc:R -- L:rabbitmq
    appointment_svc:R -- L:rabbitmq
    prescription_svc:R -- L:rabbitmq
    billing_svc:R -- L:rabbitmq

    patient_svc:R -- L:redis
    appointment_svc:R -- L:redis
    prescription_svc:R -- L:redis
    billing_svc:R -- L:redis

    patient_svc:R -- L:prometheus
    appointment_svc:R -- L:prometheus
    prescription_svc:R -- L:prometheus
    billing_svc:R -- L:prometheus
    prometheus:R -- L:grafana
