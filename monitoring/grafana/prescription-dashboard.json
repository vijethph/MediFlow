{
  "dashboard": {
    "title": "Prescription Service Metrics",
    "panels": [
      {
        "id": 1,
        "title": "Request Rate",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(prescription_service_requests_total[5m])"
          }
        ]
      },
      {
        "id": 2,
        "title": "Request Duration (95th percentile)",
        "type": "graph",
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(prescription_service_request_duration_seconds_bucket[5m]))"
          }
        ]
      },
      {
        "id": 3,
        "title": "Total Requests by Endpoint",
        "type": "graph",
        "targets": [
          {
            "expr": "sum(rate(prescription_service_requests_total[5m])) by (endpoint)"
          }
        ]
      },
      {
        "id": 4,
        "title": "Error Rate",
        "type": "graph",
        "targets": [
          {
            "expr": "sum(rate(prescription_service_requests_total{status=~\"5..\"}[5m]))"
          }
        ]
      }
    ]
  }
}
