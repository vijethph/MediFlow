{
  "dashboard": {
    "title": "Billing Service Metrics",
    "panels": [
      {
        "id": 1,
        "title": "Request Rate",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(billing_service_requests_total[5m])"
          }
        ]
      },
      {
        "id": 2,
        "title": "Request Duration (95th percentile)",
        "type": "graph",
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(billing_service_request_duration_seconds_bucket[5m]))"
          }
        ]
      }
    ]
  }
}
